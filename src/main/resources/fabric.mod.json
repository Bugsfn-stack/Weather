{
  "schemaVersion": 1,
  "id": "weatherglass",
  "version": "${version}",
  "name": "Weather Glass",
  "description": "The weather shows on your windows: raindrops running down the glass when it rains, frost and snowflakes when it snows, sand after the storms of dry biomes. Glass blocks, panes, stained and tinted glass.",
  "authors": [
    "DuffoPuffo"
  ],
  "license": "PolyForm-Shield-1.0.0",
  "icon": "assets/weatherglass/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.duffopuffo.weatherglass.fabric.WeatherGlassFabric"
    ],
    "modmenu": [
      "com.duffopuffo.weatherglass.fabric.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
